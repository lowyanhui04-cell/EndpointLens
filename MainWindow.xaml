<Window x:Class="WindowsSecurityAudit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Security Audit" Width="1100" Height="720" WindowStartupLocation="CenterScreen" Background="#F4F7FB">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#12263A">
            <StackPanel>
                <TextBlock Text="🛡 Windows Security Audit" Foreground="White" FontSize="18" FontWeight="Bold" Margin="18,24,12,35" TextWrapping="Wrap"/>
                <Button Content="Home" Click="Home_Click" Margin="12,4" Padding="12" HorizontalContentAlignment="Left"/>
                <Button Content="Audit" Click="Audit_Click" Margin="12,4" Padding="12" HorizontalContentAlignment="Left"/>
                <Button Content="Results" Click="Results_Click" Margin="12,4" Padding="12" HorizontalContentAlignment="Left"/>
                <Button Content="Reports" Click="Reports_Click" Margin="12,4" Padding="12" HorizontalContentAlignment="Left"/>
                <TextBlock Text="Portable Edition" Foreground="#AFC2D6" Margin="18,40,12,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">
                <TextBlock Text="Automated IT Security Audit System" FontSize="30" FontWeight="Bold" Foreground="#12263A"/>
                <TextBlock Text="Windows Endpoint" FontSize="22" Foreground="#1677FF" Margin="0,0,0,25"/>

                <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Endpoint Information" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ComputerText" Margin="0,15,0,0"/>
                            <TextBlock x:Name="OsText" Margin="0,6,0,0"/>
                            <TextBlock Text="Audit Standard: CIS / Windows Security Baseline (custom mapping)" Margin="0,6,0,0"/>
                            <TextBlock Text="Security Checks: 11 in this MVP" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="StartButton" Content="▶  START SECURITY AUDIT" Click="StartAudit_Click" Background="#1677FF" Foreground="White" FontWeight="Bold" Padding="24,14" BorderThickness="0"/>
                            <TextBlock x:Name="AdminText" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Audit Progress" FontSize="20" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="Progress" Height="16" Margin="0,14,0,10" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="ProgressText" Text="Ready. Click Start Audit."/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Audit Summary" FontSize="20" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,16,0,0">
                            <TextBlock x:Name="ScoreText" Text="Score: --" FontSize="24" FontWeight="Bold" Margin="0,0,35,0"/>
                            <TextBlock x:Name="PassText" Text="PASS: --" Foreground="#168A4A" FontSize="18" Margin="0,4,25,0"/>
                            <TextBlock x:Name="WarningText" Text="WARNING: --" Foreground="#D97706" FontSize="18" Margin="0,4,25,0"/>
                            <TextBlock x:Name="FailText" Text="FAIL: --" Foreground="#C62828" FontSize="18" Margin="0,4,0,0"/>
                        </WrapPanel>
                        <Button x:Name="ReportButton" Content="Open Latest Report" Click="Report_Click" IsEnabled="False" Margin="0,20,0,0" Padding="12" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
